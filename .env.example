# LLM provider
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
LLM_MODEL=claude-sonnet-5

# Web search tool (researcher/analyst agents)
TAVILY_API_KEY=

# Database (checkpointer + run metadata store)
DATABASE_URL=postgresql://postgres:postgres@db:5432/langgraph_crew

# API
API_DEV_KEY=dev-local-key
CORS_ORIGINS=http://localhost:5173

# Graph behavior
MAX_REVISIONS=3
CODE_EXEC_TIMEOUT_SECONDS=10
CODE_EXEC_MEMORY_LIMIT_MB=256

# Observability
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=langgraph-research-crew
LOG_LEVEL=INFO
